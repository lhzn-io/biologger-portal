# biologger-portal-runner settings (KEY=VALUE). Copy to ~/.config/biologger-portal/runner.env.

# The hub. On garnet the runner reaches the container's port directly; elsewhere use the VPN name.
PORTAL_RUNNER_HUB=http://127.0.0.1:8797

# This runner's token, alone in a file only you can read. Make one with
#   openssl rand -hex 32 > ~/.config/biologger-portal/runner.token && chmod 600 ~/.config/biologger-portal/runner.token
# and give the hub only its hash (PORTAL_RUNNER_TOKENS in portal.env):
#   printf %s "$(cat ~/.config/biologger-portal/runner.token)" | shasum -a 256
PORTAL_RUNNER_TOKEN_FILE=~/.config/biologger-portal/runner.token

# The backends this runner takes jobs for. biologger-sim's LAB mode (export-track) computes on the
# CPU whatever the config's simulation.backend says, so cpu is the honest offer for now.
PORTAL_RUNNER_BACKENDS=cpu

# Optional:
# PORTAL_RUNNER_SIM=/path/to/biologger-sim     (default: the biologger-sim installed beside the runner)
# PORTAL_RUNNER_WORK=~/.cache/biologger-portal-runner
# PORTAL_RUNNER_POLL_S=30
# PORTAL_RUNNER_SIM_COMMIT=                     (only when the simulator cannot report its own commit)
