# Copy to deploy/portal.env (not committed) and fill in.

# Emails that may edit metadata, register files and run validation (JSON list). Editors are recognized only
# behind Cloudflare Access; on the VPN hub everyone is read-only until editor sign-in lands.
PORTAL_EDITORS=["editor@example.org"]

# Cloudflare Access, only if the hub is ever put behind it: the team domain and the application's audience tag.
# PORTAL_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
# PORTAL_ACCESS_AUD=<application audience tag>

# topobathykit, as the container reaches it.
PORTAL_TOPOBATHYKIT_URL=http://garnet.internal:9595

# Where "Send a suggestion" goes in the Collect tray (build-time; leave unset for no suggestion panel).
# VITE_SUGGEST_MAILTO=
