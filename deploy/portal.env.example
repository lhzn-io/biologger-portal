# Copy to ~/.config/biologger-portal/portal.env (outside the repo; chmod 600) and fill in.

# Emails that may edit metadata, register files, run simulations and see visitors (JSON list). Editors are
# recognized only through the tunnel, where Cloudflare Access signs them in; the hub read directly on the
# VPN is read-only.
PORTAL_EDITORS=["editor@example.org"]

# Cloudflare Access on the hub's tunnel hostname: the team domain and that application's audience tag.
# PORTAL_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
# PORTAL_ACCESS_AUD=<application audience tag>
# The tunnel hostname, linked as "Editor sign-in" for readers on the VPN.
# PORTAL_SIGNIN_URL=https://<hub hostname>

# The live viewer's visit log (Visitors page): an Access service token allowed on whoi-mpg.lhzn.io/api/admin/*.
# PORTAL_CF_ACCESS_CLIENT_ID=
# PORTAL_CF_ACCESS_CLIENT_SECRET=

# topobathykit, as the container reaches it.
PORTAL_TOPOBATHYKIT_URL=http://garnet.internal:9595

# Where "Send a suggestion" goes in the Collect tray (build-time; leave unset for no suggestion panel).
# VITE_SUGGEST_MAILTO=
