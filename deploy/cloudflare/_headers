# Static asset headers for the published viewer (Workers static assets).

# Hashed bundles never change under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The snapshot changes with each publish under the same names: browsers revalidate (ETag) on every view.
/data/*
  Cache-Control: private, no-cache
  X-Robots-Tag: noindex, nofollow

# Packed animal models (encrypted per build) and their index: re-fetched after each publish, never cached by others.
/models/*
  Cache-Control: private, no-cache
  X-Robots-Tag: noindex, nofollow

# The documentation changes with each publish under the same names.
/docs/*
  Cache-Control: private, no-cache
  X-Robots-Tag: noindex, nofollow

/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
